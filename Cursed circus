        </div>
      </div>

      <div class="sub-stat" id="posStatusText">Posisi: Tengah Ruangan</div>
    </div>
  </div>

  <div id="alertBanner">PERINGATAN!</div>

  <!-- Kontrol Gerak & Aksi -->
  <div id="hudControls">
    <div id="joystickZone" aria-label="Joystick Gerak">
      <div id="joystickKnob"></div>
    </div>

    <div id="actionPad">
      <button type="button" class="act-btn" id="btnDoorLeft">🚪 PINTU KIRI: TERBUKA</button>
      <button type="button" class="act-btn" id="btnFlashlight">🔦 SENTER: MATI</button>
      <button type="button" class="act-btn" id="btnLookUp">⬆️ LIHAT ATAP</button>
      <button type="button" class="act-btn" id="btnThrowMeat">🥩 LEMPAR DAGING</button>
      <button type="button" class="act-btn" id="btnRefillMeat">🧊 AMBIL DAGING</button>
      <button type="button" class="act-btn coffee-btn" id="btnDrinkCoffee">☕ MINUM KOPI</button>
    </div>
  </div>

  <!-- Menu Utama -->
  <div class="screen-overlay" id="startScreen">
    <div class="card">
      <div class="badge">SURVIVAL HOROR 3D • 3 MALAM</div>
      <h1>NIGHTS AT THE CURSED CIRCUS 3D</h1>
      <p class="desc">
        Kamu adalah penjaga malam di sirkus terkutuk. Bergeraklah bebas di dalam ruang penjaga dari pukul <strong>11:00 PM</strong> sampai <strong>06:30 AM</strong> (<strong>1 jam = 60 detik</strong>).
      </p>

      <div class="night-row">
        <button type="button" class="night-btn selected" data-night="1">MALAM 1</button>
        <button type="button" class="night-btn" data-night="2">MALAM 2</button>
        <button type="button" class="night-btn" data-night="3">MALAM 3</button>
      </div>

      <ul class="rules-list">
        <li><strong>Monyet Sirkus (Tinggi 4,0m)</strong>: Datang dari <strong>koridor kiri</strong> memakai baju sirkus. <strong>Tutup pintu kiri</strong> sebelum ia menunduk masuk.</li>
        <li><strong>Gajah Berkaki Laba-Laba & Bertaring</strong>: Merayap di <strong>langit-langit atas</strong> dan menjulurkan kaki laba-laba untuk menarikmu ke atas. <strong>Lihat ke atas</strong> lalu <strong>sorotkan senter</strong> ke arahnya!</li>
        <li><strong>Singa Berkepala 3 (Tinggi 3,9m, Mata Banyak)</strong>: Berjalan 2 kaki dari <strong>depan</strong>. <strong>Lempar daging</strong> agar ia kembali ke tempatnya (ambil daging baru kapan saja).</li>
        <li><strong>Kopi Tiap 1 Menit</strong>: Minum kopi setiap <strong>60 detik</strong> agar tidak tertidur lelap.</li>
      </ul>

      <button type="button" class="primary-btn" id="btnStartGame">▶ MULAI JAGA MALAM</button>
      <div id="statusNote">Geser layar untuk menoleh • WASD / Panah / Joystick untuk berjalan</div>
    </div>
  </div>

  <!-- Layar Menang / Kalah -->
  <div class="screen-overlay" id="endScreen">
    <div class="card">
      <div class="badge" id="endBadge">SHIFT SELESAI</div>
      <h1 id="endTitle">KAMU SELAMAT!</h1>
      <p class="desc" id="endDesc">Pukul 06:30 AM telah tiba. Fajar menyingsing di atas tenda sirkus.</p>
      <button type="button" class="primary-btn" id="btnRetry">↻ MAIN LAGI</button>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"
    onerror="var s=document.createElement('script');s.src='https://unpkg.com/three@0.128.0/build/three.min.js';document.head.appendChild(s);"></script>

  <script>
    (function () {
      'use strict';

      let audioCtx = null;
      function ensureAudio() {
        if (!audioCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) audioCtx = new AC();
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume().catch(() => {});
        }
      }

      function playTone(freq, type, duration, gainVal, slideFreq) {
        if (!audioCtx) return;
        try {
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = type || 'sawtooth';
          osc.frequency.setValueAtTime(freq, now);
          if (slideFreq) osc.frequency.exponentialRampToValueAtTime(slideFreq, now + duration);
          gain.gain.setValueAtTime(gainVal || 0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.0008, now + duration);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + duration);
        } catch (_) {}
      }

      function playJumpscareSound() {
        ensureAudio();
        playTone(135, 'sawtooth', 0.85, 0.35, 540);
        playTone(82, 'square', 0.85, 0.25, 38);
      }

      function playCoffeeSound() {
        ensureAudio();
        playTone(340, 'triangle', 0.14, 0.14, 520);
        setTimeout(() => playTone(520, 'triangle', 0.18, 0.14, 680), 120);
      }

      function playMeatThrowSound() {
        ensureAudio();
        playTone(210, 'sine', 0.16, 0.16, 95);
      }

      function playDoorSound(closed) {
        ensureAudio();
        playTone(closed ? 140 : 190, 'square', 0.18, 0.16, closed ? 55 : 110);
      }

      function createSkinTextures(baseHex, veinHex, scarHex, roughBase) {
        const size = 256;
        const cMap = document.createElement('canvas');
        cMap.width = cMap.height = size;
        const ctxM = cMap.getContext('2d');

        const cBump = document.createElement('canvas');
        cBump.width = cBump.height = size;
        const ctxB = cBump.getContext('2d');

        ctxM.fillStyle = baseHex;
        ctxM.fillRect(0, 0, size, size);

        ctxB.fillStyle = '#808080';
        ctxB.fillRect(0, 0, size, size);

        for (let i = 0; i < 2400; i++) {
          const x = Math.random() * size;
          const y = Math.random() * size;
          const r = 0.7 + Math.random() * 2.2;
          const dark = Math.random() > 0.45;
          ctxM.fillStyle = dark ? 'rgba(0,0,0,0.22)' : 'rgba(255,220,210,0.12)';
          ctxM.beginPath();
          ctxM.arc(x, y, r, 0, Math.PI * 2);
          ctxM.fill();

          ctxB.fillStyle = dark ? 'rgba(30,30,30,0.45)' : 'rgba(210,210,210,0.35)';
          ctxB.beginPath();
          ctxB.arc(x, y, r, 0, Math.PI * 2);
          ctxB.fill();
        }

        ctxM.strokeStyle = veinHex;
        ctxB.strokeStyle = '#383838';
        for (let v = 0; v < 26; v++) {
          let vx = Math.random() * size;
          let vy = Math.random() * size;
          ctxM.lineWidth = 0.9 + Math.random() * 1.8;
          ctxB.lineWidth = 1.5;
          ctxM.beginPath();
          ctxB.beginPath();
          ctxM.moveTo(vx, vy);
          ctxB.moveTo(vx, vy);
          for (let s = 0; s < 6; s++) {
            vx += (Math.random() - 0.5) * 34;
            vy += (Math.random() - 0.5) * 34;
            ctxM.lineTo(vx, vy);
            ctxB.lineTo(vx, vy);
          }
          ctxM.stroke();
          ctxB.stroke();
        }

        if (scarHex) {
          for (let k = 0; k < 14; k++) {
            const sx = Math.random() * size;
            const sy = Math.random() * size;
            ctxM.fillStyle = scarHex;
            ctxM.beginPath();
            ctxM.ellipse(sx, sy, 6 + Math.random() * 16, 2 + Math.random() * 5, Math.random() * Math.PI, 0, Math.PI * 2);
            ctxM.fill();
          }
        }

        const map = new THREE.CanvasTexture(cMap);
        const bumpMap = new THREE.CanvasTexture(cBump);
        map.wrapS = map.wrapT = THREE.RepeatWrapping;
        bumpMap.wrapS = bumpMap.wrapT = THREE.RepeatWrapping;
        map.repeat.set(2, 2);
        bumpMap.repeat.set(2, 2);

        return {
          map: map,
          bumpMap: bumpMap,
          bumpScale: 0.05,
          roughness: roughBase || 0.72,
          metalness: 0.08
        };
      }

      let selectedNight = 1;
      let gameRunning = false;
      let gameEnded = false;
      let elapsedShiftSec = 0;
      const TOTAL_SHIFT_SEC = 7.5 * 60;

      const player = {
        x: 0,
        z: 1.2,
        yaw: 0,
        pitch: 0.08,
        speed: 3.1
      };

      const ROOM_BOUNDS = {
        minX: -2.4,
        maxX: 2.4,
        minZ: -2.1,
        maxZ: 2.3
      };

      let doorClosed = false;
      let flashlightOn = false;
      let coffeeTimer = 60.0;
      const COFFEE_MAX = 60.0;
      let meatCount = 3;
      const MEAT_MAX = 5;

      const monkey = {
        progress: 0.0,
        speed: 0.032,
        group: null,
        bodyGroup: null,
        head: null,
        leftArm: null,
        rightArm: null,
        leftLeg: null,
        rightLeg: null
      };

      const spiderElephant = {
        pullProgress: 0.0,
        pullSpeed: 0.055,
        exposedTimer: 0,
        group: null,
        body: null,
        legs: []
      };

      const threeHeadLion = {
        progress: 0.0,
        speed: 0.028,
        fedCooldown: 0,
        group: null,
        bodyGroup: null,
        heads: [],
        leftLeg: null,
        rightLeg: null
      };

      const startScreen = document.getElementById('startScreen');
      const endScreen = document.getElementById('endScreen');
      const hudTop = document.getElementById('hudTop');
      const hudControls = document.getElementById('hudControls');
      const clockText = document.getElementById('clockText');
      const nightLabel = document.getElementById('nightLabel');
      const coffeeTimerText = document.getElementById('coffeeTimerText');
      const coffeeBar = document.getElementById('coffeeBar');
      const meatCountText = document.getElementById('meatCountText');
      const meatBar = document.getElementById('meatBar');
      const posStatusText = document.getElementById('posStatusText');
      const alertBanner = document.getElementById('alertBanner');
      const sleepOverlay = document.getElementById('sleepOverlay');
      const flashOverlay = document.getElementById('flashOverlay');
      const statusNote = document.getElementById('statusNote');

      const btnDoorLeft = document.getElementById('btnDoorLeft');
      const btnFlashlight = document.getElementById('btnFlashlight');
      const btnLookUp = document.getElementById('btnLookUp');
      const btnThrowMeat = document.getElementById('btnThrowMeat');
      const btnRefillMeat = document.getElementById('btnRefillMeat');
      const btnDrinkCoffee = document.getElementById('btnDrinkCoffee');

      let alertTimeout = null;
      function showAlert(msg) {
        alertBanner.textContent = msg;
        alertBanner.style.opacity = '1';
        clearTimeout(alertTimeout);
        alertTimeout = setTimeout(() => {
          alertBanner.style.opacity = '0';
        }, 1800);
      }

      document.querySelectorAll('.night-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.night-btn').forEach((b) => b.classList.remove('selected'));
          btn.classList.add('selected');
          selectedNight = parseInt(btn.getAttribute('data-night'), 10) || 1;
        });
      });

      let scene = null;
      let camera = null;
      let renderer = null;
      let spotLightFlash = null;
      let doorMesh = null;
      let thrownMeatMesh = null;
      let thrownMeatLife = 0;
      let sceneBuilt = false;

      function initThreeIfNeeded() {
        if (typeof THREE === 'undefined') {
          statusNote.textContent = 'Memuat mesin 3D Three.js... coba ketuk mulai lagi sebentar lagi.';
          return false;
        }
        if (sceneBuilt) return true;

        try {
          const container = document.getElementById('threeContainer');
          scene = new THREE.Scene();
          scene.background = new THREE.Color(0x070305);
          scene.fog = new THREE.FogExp2(0x070305, 0.058);

          camera = new THREE.PerspectiveCamera(72, window.innerWidth / window.innerHeight, 0.1, 45);
          camera.rotation.order = 'YXZ';

          renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
          renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
          renderer.shadowMap.enabled = true;
          renderer.shadowMap.type = THREE.PCFSoftShadowMap;
          container.innerHTML = '';
          container.appendChild(renderer.domElement);

          const ambient = new THREE.AmbientLight(0x30171c, 0.95);
