      let lastLookY = 0;
      const containerEl = document.getElementById('threeContainer');

      containerEl.addEventListener('pointerdown', (e) => {
        if (!gameRunning || gameEnded) return;
        lookDragging = true;
        lastLookX = e.clientX;
        lastLookY = e.clientY;
      });

      window.addEventListener('pointermove', (e) => {
        if (!lookDragging || !gameRunning || gameEnded) return;
        const dx = e.clientX - lastLookX;
        const dy = e.clientY - lastLookY;
        lastLookX = e.clientX;
        lastLookY = e.clientY;

        player.yaw -= dx * 0.0055;
