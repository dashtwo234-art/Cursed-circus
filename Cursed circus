      function formatShiftClock(secElapsed) {
        const hoursFloat = Math.min(7.5, secElapsed / 60.0);
        const totalMinutes = 23 * 60 + Math.floor(hoursFloat * 60);
        const h24 = Math.floor(totalMinutes / 60) % 24;
        const mins = totalMinutes % 60;
        const ampm = h24 >= 12 ? 'PM' : 'AM';
        let h12 = h24 % 12;
        if (h12 === 0) h12 = 12;
        const mm = mins < 10 ? '0' + mins : '' + mins;
        return `${h12}:${mm} ${ampm}`;
      }

      function updateMetersUI() {
        const cPct = Math.max(0, Math.min(100, (coffeeTimer / COFFEE_MAX) * 100));
        coffeeBar.style.width = cPct + '%';
        coffeeTimerText.textContent = Math.max(0, Math.ceil(coffeeTimer)) + 's';
        btnDrinkCoffee.classList.toggle('ready', coffeeTimer <= 20);

        const mPct = Math.max(0, Math.min(100, (meatCount / MEAT_MAX) * 100));
        meatBar.style.width = mPct + '%';
        meatCountText.textContent = meatCount + '/' + MEAT_MAX;
      }

      function triggerGameOver(reason, jumpscareTarget) {
        if (gameEnded) return;
        gameEnded = true;
        gameRunning = false;
        playJumpscareSound();

        if (jumpscareTarget && camera) {
          camera.position.set(0, 1.65, 0.3);
          camera.rotation.set(jumpscareTarget === 'elephant' ? 0.95 : 0, jumpscareTarget === 'monkey' ? Math.PI / 2 : 0, 0);
          if (jumpscareTarget === 'monkey' && monkey.group) {
            monkey.group.position.set(-1.35, 0, 0.3);
            if (monkey.bodyGroup) {
              monkey.bodyGroup.rotation.z = -0.35;
              monkey.bodyGroup.position.y = -0.35;
            }
          } else if (jumpscareTarget === 'elephant' && spiderElephant.body) {
            spiderElephant.body.position.set(0, 3.1, -0.6);
          } else if (jumpscareTarget === 'lion' && threeHeadLion.group) {
            threeHeadLion.group.position.set(0, 0, -1.35);
          }
          if (renderer && scene) renderer.render(scene, camera);
        }

        flashOverlay.style.background = '#b91c1c';
        flashOverlay.style.opacity = '0.72';
        setTimeout(() => { flashOverlay.style.opacity = '0'; }, 260);

        hudTop.style.display = 'none';
        hudControls.style.display = 'none';

        setTimeout(() => {
          document.getElementById('endBadge').textContent = 'KAMU TEWAS • MALAM ' + selectedNight;
          document.getElementById('endTitle').textContent = 'MALAPETAKA SIRKUS';
          document.getElementById('endDesc').textContent = reason;
          endScreen.style.display = 'flex';
        }, jumpscareTarget ? 550 : 80);
      }

      function triggerWin() {
        if (gameEnded) return;
        gameEnded = true;
        gameRunning = false;
        hudTop.style.display = 'none';
        hudControls.style.display = 'none';
        document.getElementById('endBadge').textContent = 'SHIFT SELESAI • MALAM ' + selectedNight;
        document.getElementById('endTitle').textContent = 'SELAMAT SAMPAI 06:30 AM!';
        document.getElementById('endDesc').textContent =
          'Cahaya pagi menembus tenda sirkus. Kamu berhasil bertahan melewati teror Malam ' + selectedNight + '!';
        endScreen.style.display = 'flex';
      }

      function resetGameState() {
        elapsedShiftSec = 0;
        gameEnded = false;
        coffeeTimer = COFFEE_MAX;
        meatCount = 3;
        doorClosed = false;
        flashlightOn = false;

        player.x = 0;
        player.z = 1.2;
        player.yaw = 0;
        player.pitch = 0.08;

        monkey.progress = 0.0;
        spiderElephant.pullProgress = 0.0;
        spiderElephant.exposedTimer = 0;
        threeHeadLion.progress = 0.0;
        threeHeadLion.fedCooldown = 0;

        if (thrownMeatMesh && scene) {
          scene.remove(thrownMeatMesh);
          thrownMeatMesh = null;
        }
        thrownMeatLife = 0;

        sleepOverlay.style.opacity = '0';
        btnDoorLeft.textContent = '🚪 PINTU KIRI: TERBUKA';
        btnDoorLeft.classList.remove('active');
        btnFlashlight.textContent = '🔦 SENTER: MATI';
        btnFlashlight.classList.remove('active');
        nightLabel.textContent = `MALAM ${selectedNight} • SHIFT 11:00 PM - 06:30 AM`;
        updateMetersUI();
      }

      function startGame() {
        ensureAudio();
        const ready = initThreeIfNeeded();
        if (!ready) return;

        resetGameState();
        startScreen.style.display = 'none';
        endScreen.style.display = 'none';
        hudTop.style.display = 'flex';
        hudControls.style.display = 'flex';
        gameRunning = true;
        showAlert('Shift dimulai! Pantau Kiri (Monyet), Atas (Gajah), Depan (Singa), & Kopi!');
      }

      document.getElementById('btnStartGame').addEventListener('click', startGame);
      document.getElementById('btnRetry').addEventListener('click', startGame);

      let lastTime = performance.now();

      function updateSimulation(dt, nowSec) {
        elapsedShiftSec += dt;
        clockText.textContent = formatShiftClock(elapsedShiftSec);

        if (elapsedShiftSec >= TOTAL_SHIFT_SEC) {
          triggerWin();
          return;
        }

        coffeeTimer -= dt;
        if (coffeeTimer <= 0) {
          triggerGameOver('Kamu tertidur lelap karena tidak meminum kopi tepat waktu!', null);
          return;
        }

        if (coffeeTimer < 18) {
          const drowsiness = Math.min(0.68, ((18 - coffeeTimer) / 18) * 0.68);
          sleepOverlay.style.opacity = (drowsiness + Math.sin(nowSec * 5) * 0.06).toFixed(2);
        } else {
          sleepOverlay.style.opacity = '0';
        }

        let moveForward = -joyVec.y;
        let moveRight = joyVec.x;
        if (keys['KeyW'] || keys['ArrowUp']) moveForward += 1;
        if (keys['KeyS'] || keys['ArrowDown']) moveForward -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) moveRight += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) moveRight -= 1;

        const len = Math.hypot(moveForward, moveRight);
        if (len > 0.01) {
          moveForward /= Math.max(1, len);
          moveRight /= Math.max(1, len);

          const sinY = Math.sin(player.yaw);
          const cosY = Math.cos(player.yaw);

          const forwardX = -sinY;
          const forwardZ = -cosY;
          const rightX = cosY;
          const rightZ = -sinY;

          player.x += (forwardX * moveForward + rightX * moveRight) * player.speed * dt;
          player.z += (forwardZ * moveForward + rightZ * moveRight) * player.speed * dt;

          player.x = Math.max(ROOM_BOUNDS.minX, Math.min(ROOM_BOUNDS.maxX, player.x));
          player.z = Math.max(ROOM_BOUNDS.minZ, Math.min(ROOM_BOUNDS.maxZ, player.z));
        }

        posStatusText.textContent = `Posisi: (${player.x.toFixed(1)}, ${player.z.toFixed(1)})`;

        if (doorMesh) {
          const targetDoorY = doorClosed ? 1.38 : 4.1;
          doorMesh.position.y += (targetDoorY - doorMesh.position.y) * Math.min(1, dt * 10);
        }

        if (spotLightFlash) {
          spotLightFlash.intensity = flashlightOn ? 3.5 : 0;
        }

        if (thrownMeatMesh && thrownMeatLife > 0) {
          thrownMeatLife -= dt;
          thrownMeatMesh.position.z -= dt * 0.6;
          thrownMeatMesh.rotation.x += dt * 4;
          if (thrownMeatLife <= 0) {
            scene.remove(thrownMeatMesh);
            thrownMeatMesh = null;
          }
        }

        const nightMult = 1 + (selectedNight - 1) * 0.28;

        // 1) MONYET SIRKUS (4.0m) DARI KIRI
        monkey.progress += monkey.speed * nightMult * dt;
        const monkeyX = -7.6 + monkey.progress * 4.4;
        let crouchFactor = 0;

        if (monkey.progress > 0.58) {
          crouchFactor = Math.min(1, (monkey.progress - 0.58) / 0.35);
        }

        if (monkey.group) {
          monkey.group.position.set(monkeyX, 0, 0.05);
          const stride = Math.sin(nowSec * 9) * 0.35;
          if (monkey.leftLeg) monkey.leftLeg.rotation.z = stride;
          if (monkey.rightLeg) monkey.rightLeg.rotation.z = -stride;
          if (monkey.leftArm) monkey.leftArm.rotation.z = -stride * 0.7;
          if (monkey.rightArm) monkey.rightArm.rotation.z = stride * 0.7;

          if (monkey.bodyGroup) {
            monkey.bodyGroup.rotation.z = -crouchFactor * 0.75;
            monkey.bodyGroup.position.y = -crouchFactor * 0.82;
          }
          if (monkey.head) {
            monkey.head.rotation.z = crouchFactor * 0.45;
            monkey.head.rotation.y = Math.sin(nowSec * 4) * 0.18;
          }
        }

        if (monkey.progress >= 1.0) {
          if (doorClosed) {
            monkey.progress = 0.05;
            showAlert('🚪 Pintu kiri tertutup! Monyet Sirkus mundur ke kejauhan.');
          } else {
            triggerGameOver('Monyet Sirkus setinggi 4 meter menunduk masuk lewat pintu kiri yang terbuka!', 'monkey');
            return;
          }
        }

        // 2) GAJAH BERKAKI LABA-LABA DI ATAS (+Y)
        spiderElephant.pullProgress += spiderElephant.pullSpeed * nightMult * 0.65 * dt;

        const liftOffset = spiderElephant.pullProgress > 0.55 ? (spiderElephant.pullProgress - 0.55) * 3.4 : 0;
        if (camera) {
          camera.position.set(player.x, 1.62 + liftOffset, player.z);
          camera.rotation.y = player.yaw;
          camera.rotation.x = player.pitch;
        }

        const lookingUp = player.pitch > 0.55;
        const shiningAtElephant = flashlightOn && lookingUp;

        if (shiningAtElephant) {
          spiderElephant.exposedTimer += dt;
          spiderElephant.pullProgress = Math.max(0, spiderElephant.pullProgress - dt * 0.48);
          if (spiderElephant.exposedTimer > 0.55) {
            spiderElephant.exposedTimer = 0;
            showAlert('🔦 Senter mengenai Gajah Laba-Laba di atas! Ia menarik kakinya kembali.');
          }
        } else {
          spiderElephant.exposedTimer = 0;
        }

        if (spiderElephant.body) {
          const descent = spiderElephant.pullProgress * 2.1;
          spiderElephant.body.position.y = 4.35 - descent;
          spiderElephant.body.position.x = Math.sin(nowSec * 1.6) * 0.55;
          spiderElephant.body.position.z = -0.35 + Math.cos(nowSec * 1.3) * 0.45;

          spiderElephant.legs.forEach((lg) => {
            lg.mesh.rotation.x = Math.sin(nowSec * 8 + lg.phase) * 0.25;
            lg.mesh.position.y = -0.85 - spiderElephant.pullProgress * 0.65;
          });
        }

        if (spiderElephant.pullProgress >= 1.0) {
          triggerGameOver('Gajah berkaki laba-laba & bertaring tajam menarikmu ke atap sirkus!', 'elephant');
          return;
        }

        // 3) SINGA BERKEPALA 3 (3.9m, 2 KAKI MANUSIA) DARI DEPAN (-Z)
        if (threeHeadLion.fedCooldown > 0) {
          threeHeadLion.fedCooldown -= dt;
        } else {
          threeHeadLion.progress += threeHeadLion.speed * nightMult * dt;
        }

        const lionZ = -8.2 + threeHeadLion.progress * 4.5;
        if (threeHeadLion.group) {
          threeHeadLion.group.position.set(Math.sin(nowSec * 1.2) * 0.4, 0, lionZ);
          const walkSwing = Math.sin(nowSec * 7.5) * 0.42;
          if (threeHeadLion.leftLeg) threeHeadLion.leftLeg.rotation.x = walkSwing;
          if (threeHeadLion.rightLeg) threeHeadLion.rightLeg.rotation.x = -walkSwing;
          if (threeHeadLion.bodyGroup) {
            threeHeadLion.bodyGroup.position.y = Math.abs(Math.cos(nowSec * 7.5)) * 0.08;
          }
          threeHeadLion.heads.forEach((h) => {
            h.mesh.rotation.y = Math.sin(nowSec * 3.5 + h.phase) * 0.22;
            h.mesh.rotation.x = Math.cos(nowSec * 4.2 + h.phase) * 0.12;
          });
        }

        if (threeHeadLion.progress >= 1.0) {
          triggerGameOver('Singa berkepala 3 bermata banyak menerobos dari depan karena kelaparan!', 'lion');
          return;
        }

        updateMetersUI();
      }

      function renderLoop(now) {
        requestAnimationFrame(renderLoop);
        const dt = Math.min(0.08, (now - lastTime) / 1000);
        lastTime = now;

        if (gameRunning && !gameEnded) {
          updateSimulation(dt, now / 1000);
        }

        if (renderer && scene && camera) {
          renderer.render(scene, camera);
        }
      }

      requestAnimationFrame(renderLoop);
    })();
  </script>
</body>
